# Base de datos — para `npm run dev` / Prisma en tu PC contra Postgres en Docker (puerto mapeado):
DATABASE_URL=postgresql://quantis:quantis_dev@localhost:5432/quantis
# El servicio `api` en docker-compose.yml fuerza host `postgres`; no hace falta cambiar esta línea al usar Docker.

# API
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000

# Frontend (CORS, OAuth, emails). Varios orígenes separados por coma (CORS); el primero se usa en OAuth y emails.
# Ejemplo: Vite 5173 + front en Docker 8080
FRONTEND_URL=http://localhost:5173,http://localhost:8080

# El contenedor `web` se levanta aparte en Quantis-Frontend/docker-compose.yml (no en este repo).

# Auth
JWT_SECRET=change_me_in_production
SESSION_SECRET=change_me_session

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email (recuperación de contraseña)
EMAIL_USER=
EMAIL_PASS=

# Subidas
MAX_FILE_SIZE=5242880
