generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// IDs VARCHAR(24) compatibles con ObjectId de MongoDB

enum UserRole {
  USER
  SUPER_ADMIN
}

model User {
  id                     String   @id @db.VarChar(24)
  name                   String
  email                  String   @unique
  password               String?
  googleId               String?  @unique
  avatar                 String?
  isEmailVerified        Boolean  @default(false)
  resetPasswordToken     String?
  resetPasswordExpires   DateTime?
  profileImage           String?
  profileImageData       Bytes?
  profileImageContentType String?
  currency               String   @default("GTQ") // GTQ | USD
  isActive               Boolean  @default(true)
  role                   UserRole @default(USER)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  ingresos              Ingreso[]
  gastos                Gasto[]
  tarjetas              Tarjeta[]
  cuotas                Cuota[]
  prestamos             Prestamo[]
  tiposTransaccion      TipoTransaccion[]
  ingresosRecurrentes   IngresoRecurrente[]
  gastosRecurrentes     GastoRecurrente[]
  transaccionesGeneradas TransaccionGenerada[]
  gastosFijos           GastoFijo[]
  cuentas               Cuenta[]
  feedbacks             Feedback[]

  @@map("users")
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

model Feedback {
  id         String          @id @db.VarChar(24)
  userId     String          @db.VarChar(24)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  message    String
  meta       Json?
  status        FeedbackStatus  @default(NEW)
  /** Primera vez que un admin abre el detalle (para ocultar badge "Nuevo") */
  adminOpenedAt DateTime?
  adminNote     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@map("feedbacks")
}

model Cuenta {
  id        String   @id @db.VarChar(24)
  userId    String   @db.VarChar(24)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nombre    String
  moneda    String
  saldoInicial Float @default(0)
  esActiva  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingresos Ingreso[]
  gastos   Gasto[]
  ingresosRecurrentes IngresoRecurrente[]
  gastosRecurrentes  GastoRecurrente[]

  @@index([userId])
  @@index([userId, moneda])
  @@map("cuentas")
}

model Ingreso {
  id           String   @id @db.VarChar(24)
  userId       String   @db.VarChar(24)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cuentaId     String?  @db.VarChar(24)
  cuenta       Cuenta?  @relation(fields: [cuentaId], references: [id], onDelete: SetNull)
  tipo         String
  monto        Float
  moneda       String
  fecha        DateTime
  descripcion  String?
  esRecurrente Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, fecha(sort: Desc)])
  @@index([userId, cuentaId, fecha(sort: Desc)])
  @@map("ingresos")
}

model Gasto {
  id               String   @id @db.VarChar(24)
  userId           String   @db.VarChar(24)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cuentaId         String?  @db.VarChar(24)
  cuenta           Cuenta?  @relation(fields: [cuentaId], references: [id], onDelete: SetNull)
  categoria        String
  monto            Float
  moneda           String
  fecha            DateTime
  descripcion      String?
  esRecurrente     Boolean  @default(false)
  metodoPago       String   @default("efectivo")
  cuotaId          String?  @db.VarChar(24)
  cuota            Cuota?   @relation(fields: [cuotaId], references: [id], onDelete: SetNull)
  numeroCuotaPago  Int?
  tarjetaId        String?  @db.VarChar(24)
  tarjeta          Tarjeta? @relation(fields: [tarjetaId], references: [id], onDelete: SetNull)
  esPagoTarjeta    Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, fecha(sort: Desc)])
  @@index([userId, cuentaId, fecha(sort: Desc)])
  @@index([userId, categoria])
  @@index([userId, tarjetaId, fecha(sort: Desc)])
  @@map("gastos")
}

model Tarjeta {
  id                 String   @id @db.VarChar(24)
  userId             String   @db.VarChar(24)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nombre             String
  tipo               String // credito | debito
  banco              String?
  numeroUltimosDigitos String?
  limiteCredito      Float?
  moneda             String
  diaPago            Int?
  fechaCorte         Int?
  saldoActual        Float    @default(0)
  disponible         Float    @default(0)
  esActiva           Boolean  @default(true)
  descripcion        String?
  color              String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cuotas Cuota[]
  gastos Gasto[]

  @@index([userId, tipo])
  @@index([userId, esActiva])
  @@map("tarjetas")
}

model Cuota {
  id                    String   @id @db.VarChar(24)
  userId                String   @db.VarChar(24)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nombre                String
  montoTotal            Float
  montoCuota            Float
  cuotasTotal           Int
  cuotasPagadas         Int      @default(0)
  moneda                String
  frecuenciaPago        String
  fechaInicio           DateTime
  fechaVencimiento      DateTime
  proximoPago           DateTime
  historialPagos        Json     @default("[]")
  descripcion           String?
  categoria             String?
  estado                String   @default("activa")
  notificaciones        Json     @default("{}")
  tarjetaId             String?  @db.VarChar(24)
  tarjeta               Tarjeta? @relation(fields: [tarjetaId], references: [id], onDelete: SetNull)
  crearGastoAutomatico  Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  gastos Gasto[]

  @@index([userId, estado])
  @@index([userId, proximoPago])
  @@index([userId, fechaVencimiento])
  @@map("cuotas")
}

model Prestamo {
  id                String   @id @db.VarChar(24)
  userId            String   @db.VarChar(24)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo              String // recibido | otorgado
  nombre            String
  montoTotal        Float
  montoPagado       Float    @default(0)
  moneda            String
  fechaInicio       DateTime
  fechaVencimiento  DateTime
  tasaInteres       Float    @default(0)
  frecuenciaPago    String   @default("mensual")
  historialPagos    Json     @default("[]")
  estado            String   @default("activo")
  contacto          Json?
  descripcion       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, estado])
  @@index([userId, tipo])
  @@index([userId, fechaVencimiento])
  @@map("prestamos")
}

model TipoTransaccion {
  id      String   @id @db.VarChar(24)
  userId  String   @db.VarChar(24)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo    String // ingreso | gasto
  slug    String
  label   String
  iconKey String?
  color   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tipo, slug])
  @@map("tipos_transaccion")
}

model IngresoRecurrente {
  id               String    @id @db.VarChar(24)
  userId           String    @db.VarChar(24)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cuentaId         String?   @db.VarChar(24)
  cuenta           Cuenta?   @relation(fields: [cuentaId], references: [id], onDelete: SetNull)
  nombre           String
  monto            Float
  moneda           String
  frecuencia       String
  diaPago          Int?
  diaSemana        Int?
  fechaInicio      DateTime
  fechaFin         DateTime?
  esActivo         Boolean   @default(true)
  categoria        String?
  descripcion      String?
  ultimaGeneracion DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, esActivo])
  @@map("ingresos_recurrentes")
}

model GastoRecurrente {
  id               String    @id @db.VarChar(24)
  userId           String    @db.VarChar(24)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cuentaId         String?   @db.VarChar(24)
  cuenta           Cuenta?   @relation(fields: [cuentaId], references: [id], onDelete: SetNull)
  nombre           String
  monto            Float
  moneda           String
  frecuencia       String
  diaPago          Int?
  diaSemana        Int?
  fechaInicio      DateTime
  fechaFin         DateTime?
  esActivo         Boolean   @default(true)
  categoria        String
  metodoPago       String    @default("tarjeta_credito")
  esSuscripcion    Boolean   @default(false)
  descripcion      String?
  ultimaGeneracion DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, esActivo])
  @@map("gastos_recurrentes")
}

model TransaccionGenerada {
  id               String   @id @db.VarChar(24)
  tipo             String // ingreso_recurrente | gasto_recurrente
  recurrenciaId    String   @db.VarChar(24)
  recurrenciaModel String
  transaccionId    String   @db.VarChar(24)
  transaccionModel String
  fechaGeneracion  DateTime
  periodo          String
  userId           String   @db.VarChar(24)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([recurrenciaId, periodo, tipo])
  @@index([userId, fechaGeneracion(sort: Desc)])
  @@index([recurrenciaId, tipo])
  @@index([periodo])
  @@map("transacciones_generadas")
}

model GastoFijo {
  id          String    @id @db.VarChar(24)
  userId      String    @db.VarChar(24)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nombre      String
  monto       Float
  moneda      String
  categoria   String
  descripcion String?
  diaPago     Int
  esActivo    Boolean   @default(true)
  esRecurrente Boolean  @default(true)
  fechaInicio DateTime  @default(now())
  fechaFin    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, esActivo])
  @@map("gastos_fijos")
}
